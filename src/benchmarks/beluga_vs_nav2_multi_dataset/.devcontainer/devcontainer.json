{
    "image": "ekumenlabs/beluga-vs-nav2:dev",

    "mounts": [
        {"source": "${localEnv:DEVCONTAINER_DATA:/tmp}", "target": "/data", "type": "bind"},
        {"source": "beluga-vs-nav2-ccache", "target": "/ccache", "type": "volume"}
    ],
    "workspaceMount": "source=${localWorkspaceFolder}/../..,target=/workspace/src/lambkin,type=bind,consistency=cached",
    "workspaceFolder": "/workspace",

	"customizations": {
		"vscode": {
			"extensions": [
				"tumit.vscode-rf-formatter",
				"robocorp.robotframework-lsp"
			]
		}
	},

    "shutdownAction":"none"
}
